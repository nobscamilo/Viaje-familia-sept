# Firebase Web SDK. Sin estas variables la app arranca igual, en modo local
# con los datos de src/data/. Es a proposito: `npm run dev` tiene que
# funcionar sin credenciales.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Viaje activo por defecto
VITE_TRIP_ID=sept-2026

# Mapa. Clave de NAVEGADOR de Google Maps, restringida por dominio en la
# consola. No es un secreto de verdad — cualquiera puede sacarla del JS de la
# pagina — asi que lo que acota el gasto es el tope diario de la API, no la
# restriccion por dominio. Sin esta variable la pantalla Mapa enseña la lista
# de sitios y avisa de que el mapa no esta configurado; nada se rompe.
VITE_GOOGLE_MAPS_KEY=
